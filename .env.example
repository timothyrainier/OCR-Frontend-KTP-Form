# File ini untuk menjalankan di komputer sendiri.
# Di Cloud Run, semua nilai diatur otomatis oleh deploy-cloudrun.sh.

# ======= Mode OCR =======
# mock       = simulasi (tanpa Google), cocok untuk uji coba tampilan & alur
# documentai = pakai Google Document AI Form Parser
OCR_MODE=mock

# ======= Google Document AI (isi saat OCR_MODE=documentai) =======
GCP_PROJECT_ID=
GCP_LOCATION=us
DOCAI_PROCESSOR_ID=
# DOCAI_PROCESSOR_VERSION=
# Di komputer sendiri: path file JSON service account. Di Cloud Run tidak perlu.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
# Batas Google untuk proses online adalah 40 MB dan 15 halaman per request.
# Gambar yang lebih besar dikompres otomatis; PDF yang lebih besar ditolak dengan pesan jelas.
DOCAI_ONLINE_MAX_MB=38

# ======= Login operator =======
# Kosong = tanpa login (hanya untuk dicoba di komputer sendiri)
# AUTH_USERS=admin:kata-sandi-kuat,operator1:kata-sandi-lain
AUTH_USERS=
SECRET_KEY=ganti-dengan-teks-acak-panjang
SESSION_HOURS=12

# ======= Database =======
# Kosong = SQLite di data/ocr.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ocr
# "Kirim ke database" memakai database yang sama bila EXPORT_DATABASE_URL kosong
# EXPORT_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ocr

# ======= Penyimpanan file =======
STORAGE_BACKEND=local
# STORAGE_BACKEND=gcs
# GCS_BUCKET=nama-bucket

# ======= Lain-lain =======
APP_TIMEZONE=Asia/Jakarta
MAX_UPLOAD_MB=100
LOW_CONFIDENCE_THRESHOLD=0.80
ENABLE_DOCS=true

# ======= Khusus mode mock =======
MOCK_FAIL_RATE=0.12
MOCK_LOW_QUALITY_RATE=0.2
MOCK_DELAY_SECONDS=1.2
